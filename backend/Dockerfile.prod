# Test and production image (T20): runtime dependencies only, gunicorn instead of runserver.
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Decision В-8.1: inspection videos are checked (ffprobe) and compressed (ffmpeg) on the server.
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Exact versions of requirements.lock (audit item 9): the build installs what was checked.
COPY requirements.txt requirements.lock ./
RUN pip install -r requirements.txt -c requirements.lock && useradd --system --no-create-home c4rsys \
    && mkdir -p /data/files && chown c4rsys /data/files

COPY . .
USER c4rsys

EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=5s --retries=12 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=4)"
# Audit item 20: threads, so a few slow requests (a long upload of a video, a stuck query) do not
# leave the site without free workers; migrations run without the query time limits.
CMD ["sh", "-c", "C4R_DB_STATEMENT_TIMEOUT_MS=0 C4R_DB_IDLE_TRANSACTION_TIMEOUT_MS=0 python manage.py migrate --noinput && gunicorn config.wsgi:application --bind 0.0.0.0:8000 --workers ${GUNICORN_WORKERS:-3} --worker-class gthread --threads ${GUNICORN_THREADS:-4} --timeout ${GUNICORN_TIMEOUT:-120} --access-logfile -"]
