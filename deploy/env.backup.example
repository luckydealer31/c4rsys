# Off-server copy of the backups (scripts/backup.sh). On the server: /opt/c4rsys/.env.backup,
# never committed; kept apart from .env.prod so the application containers do not see these keys.
# Values without quotes. Postponed on the test server (customer decision 03.11.2026). For Timeweb
# Cloud S3 the endpoint, region and keys are on the storage page in the Timeweb panel.
C4R_BACKUP_S3_ENDPOINT=https://s3.timeweb.cloud
C4R_BACKUP_S3_REGION=ru-1
C4R_BACKUP_S3_BUCKET=
C4R_BACKUP_S3_ACCESS_KEY=
C4R_BACKUP_S3_SECRET_KEY=
