# Copy to .env.prod on the server and fill in. Never commit .env.prod.

# Web address and ports.
C4R_SITE_ADDRESS=test.c4rsys.com
C4R_PUBLIC_URL=https://test.c4rsys.com
# 127.0.0.1 is for the container health check.
DJANGO_ALLOWED_HOSTS=test.c4rsys.com,system4rent.com,127.0.0.1
# The personal cabinet on its own domain (decision of 30.10.2026). Add it to C4R_SITE_ADDRESS
# ("test.c4rsys.com, system4rent.com") once its DNS points to the server.
C4R_CABINET_HOSTS=system4rent.com
C4R_CABINET_URL=https://system4rent.com
# If another web server already holds 80/443, bind Caddy locally and proxy to it:
# C4R_SITE_ADDRESS=:80
# C4R_HTTP_BIND=127.0.0.1:8080
# C4R_HTTPS_BIND=127.0.0.1:8443
C4R_HTTP_BIND=80
C4R_HTTPS_BIND=443

# Secrets: generate, for example, with `openssl rand -base64 48`.
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# Mail through Amazon SES (Sydney), sender no-reply@c4rsys.com (decision on T20).
C4R_MAIL_MODE=email
DJANGO_MAIL_BACKEND=anymail.backends.amazon_ses.EmailBackend
C4R_MAIL_FROM=c4rsys <no-reply@c4rsys.com>
AWS_SES_REGION=ap-southeast-2
# Keys of an IAM user allowed only ses:SendEmail and ses:SendRawEmail.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

DJANGO_LOG_LEVEL=INFO

# Reference exchange rates (ТЗ § 17.1.6) from ExchangeRate-API: the key from its dashboard.
# Without it no rates are downloaded and cross-currency operations need a manual rate.
C4R_EXCHANGE_RATE_API_KEY=
