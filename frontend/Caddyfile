# C4R_SITE_ADDRESS: "test.c4rsys.com" gets HTTPS automatically; ":80" serves plain HTTP
# (a local check, or a server where another web server already terminates HTTPS).
# Audit item 47: while the backend restarts at a deploy, a request waits up to 60 s for it
# instead of an error. Only a connection that failed is tried again, so nothing runs twice.
(backend_restart) {
	lb_try_duration 60s
	lb_try_interval 500ms
}

# Audit item 29: the check of Docker (HEALTHCHECK of Dockerfile.prod). Inside the container only,
# without HTTPS: Caddy runs and serves the built interface from /srv. The site from outside
# (HTTPS, the backend behind it) is watched through /api/health/full by the external monitor.
http://127.0.0.1:8080 {
	bind 127.0.0.1
	root * /srv
	file_server
}

{$C4R_SITE_ADDRESS::80} {
	encode zstd gzip

	# Uploads: an inspection video is limited by its duration (§ 10.4.2); the original from a
	# phone may be large. The backend caps it (MAX_VIDEO_BYTES); this cap is a little above.
	handle /api/files {
		request_body {
			max_size 1100MB
		}
		reverse_proxy backend:8000 {
			import backend_restart
		}
	}

	# Audit item 35: every other request is cut at 20 MB before it reaches the backend; the largest
	# is an import file of 5 MB, a JSON body is capped by Django at 2.5 MB (PROPOSAL).
	handle /api/* {
		request_body {
			max_size 20MB
		}
		reverse_proxy backend:8000 {
			import backend_restart
		}
	}

	# Hashed files of the build never change under the same name; a missing one is a plain 404,
	# never index.html under a long cache.
	handle /assets/* {
		root * /srv
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# index.html, sw.js and the routes of the interface are checked on every load: a new release
	# and a new service worker (§ 10.4.3) are picked up at once. The worker sits at the root, so
	# its scope is the whole site.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# Audit item 40. CSP: scripts, styles and requests only from this site; Cloudflare Turnstile
	# (its script and frame) is the one outside source. blob: and data: are the photos, videos and
	# files shown before upload or after download. frame-ancestors: no other site can embed the
	# pages (clickjacking). HSTS: browsers come back over HTTPS only, for a year (PROPOSAL, агент,
	# не подтверждено); without HTTPS (a local check on :80) browsers ignore it.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self'; frame-src https://challenges.cloudflare.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Permissions-Policy "geolocation=(self), camera=(self), microphone=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
	}
}
