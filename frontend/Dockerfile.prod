# Test and production web server (T20): the interface is built once and served by Caddy,
# which also proxies /api to the backend and obtains the HTTPS certificate.
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

FROM caddy:2.10.2-alpine
COPY --from=build /app/dist /srv
COPY Caddyfile /etc/caddy/Caddyfile
# Audit item 38: not root. /data keeps the certificates, /config the autosaved configuration.
RUN addgroup -S -g 1000 caddy && adduser -S -D -H -u 1000 -G caddy caddy \
    && chown -R caddy:caddy /data /config
USER caddy
# Audit item 29: deploy.sh waits for this check (up --wait), so a Caddy that does not serve the
# interface fails the deploy instead of passing it.
HEALTHCHECK --interval=10s --timeout=5s --retries=3 --start-period=30s --start-interval=2s \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/index.html || exit 1
